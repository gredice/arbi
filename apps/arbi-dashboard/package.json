{
  "name": "@arbi/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "node ../../scripts/ci/production-gate.mjs && next build --webpack",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --no-wasm-code-gc --import tsx --test --test-concurrency=1 src/enrollment/*.test.ts src/media/*.test.ts src/audit/*.test.ts src/jobs/*.test.ts src/realtime/*.test.ts src/dashboard/*.test.ts src/releases/*.test.ts src/telemetry/*.test.ts src/usage/*.test.ts",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:http": "node scripts/test-http.mjs && node scripts/test-http.mjs --preview",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:migrate:media": "node --import tsx scripts/migrate-media.ts",
    "db:migrate:audit": "node --import tsx scripts/migrate-audit.ts",
    "db:migrate:jobs": "node --import tsx scripts/migrate-jobs.ts",
    "db:migrate:telemetry": "node --import tsx scripts/migrate-telemetry.ts",
    "db:migrate:usage": "node --import tsx scripts/migrate-usage.ts",
    "telemetry:maintain": "node --import tsx scripts/telemetry-worker.ts",
    "db:migrate:realtime": "node --import tsx scripts/migrate-realtime.ts",
    "realtime:maintain": "node --import tsx scripts/realtime-worker.ts",
    "test:browser": "node scripts/test-shell.mjs",
    "db:provision-dashboard-test": "node --import tsx scripts/provision-dashboard-test.ts"
  },
  "dependencies": {
    "@arbi/audit": "workspace:*",
    "@arbi/gredice": "workspace:*",
    "@arbi/protocol": "workspace:*",
    "@arbi/simulation-core": "workspace:*",
    "@vercel/blob": "2.8.1",
    "ably": "2.29.0",
    "jose": "6.2.12",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.58.2",
    "@types/node": "24.12.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "tsx": "4.21.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
