{
  "name": "@arbi/pod-firmware",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-identity.mjs",
    "lint": "tsc -p tsconfig.json --noEmit && node --check scripts/build-identity.mjs && node --check scripts/benchmark.mjs && node --check scripts/runtime.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test --test-concurrency=1 dist/*.test.js scripts/*.test.mjs",
    "start": "node dist/cli.js",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "@arbi/protocol": "workspace:*",
    "@arbi/audit": "workspace:*",
    "@arbi/traffic": "workspace:*",
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@arbi/edge-controller": "workspace:*",
    "@types/node": "24.12.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
