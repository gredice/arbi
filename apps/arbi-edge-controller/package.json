{
  "name": "@arbi/edge-controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-identity.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/*.test.js",
    "start": "node dist/cli.js",
    "simulate": "node dist/cli.js --simulate",
    "supervise": "node dist/supervisor.js"
  },
  "dependencies": { "@arbi/protocol": "workspace:*", "ajv": "8.17.1" },
  "devDependencies": { "@types/node": "24.12.4", "typescript": "7.0.2" },
  "engines": { "node": ">=24" }
}
