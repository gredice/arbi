{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gredice.github.io/arbi/schemas/builds.schema.json",
  "title": "ARBI builds",
  "type": "object",
  "required": ["schemaVersion", "builds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "builds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "assemblies"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "assemblies": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["assemblyId", "quantity"],
              "properties": {
                "assemblyId": { "$ref": "#/$defs/id" },
                "quantity": { "$ref": "#/$defs/decimal" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "decimal": { "type": "string", "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
  }
}
