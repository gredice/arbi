{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gredice.github.io/arbi/schemas/suppliers.schema.json",
  "title": "ARBI suppliers",
  "type": "object",
  "required": ["schemaVersion", "suppliers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suppliers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "checkoutGroupIds", "website"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "checkoutGroupIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "website": {
            "oneOf": [
              { "type": "string", "minLength": 1, "format": "uri" },
              { "type": "null" }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
  }
}
