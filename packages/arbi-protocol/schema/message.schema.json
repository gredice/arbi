{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arbi.gredice.com/schemas/protocol/1.0/message.schema.json",
  "title": "ARBI protocol 1.0 message",
  "description": "Strict transport-neutral contracts. Structural validation never authorizes hardware. See docs/software/protocol.md for semantic rules.",
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "Counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "MonotonicMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ErrorCode": {
      "enum": [
        "INVALID_JSON",
        "MESSAGE_TOO_LARGE",
        "UNSUPPORTED_VERSION",
        "UNKNOWN_KIND",
        "UNKNOWN_TYPE",
        "UNKNOWN_FIELD",
        "INVALID_MESSAGE",
        "INVALID_RANGE",
        "REALM_MISMATCH",
        "SITE_MISMATCH",
        "SOURCE_MISMATCH",
        "TARGET_MISMATCH",
        "TARGET_RESTARTED",
        "SESSION_MISMATCH",
        "DEADLINE_EXPIRED",
        "DEADLINE_TOO_FAR",
        "LEASE_REQUIRED",
        "LEASE_STALE",
        "LEASE_EXPIRED",
        "NOT_AUTHORIZED",
        "CONFIG_MISMATCH",
        "UNSUPPORTED_CAPABILITY",
        "FAULT_INHIBITED",
        "IDEMPOTENCY_CONFLICT",
        "SEQUENCE_REPLAY",
        "RESYNC_REQUIRED",
        "CLOCK_INVALID",
        "QUALITY_UNSUPPORTED",
        "INVALID_TRANSITION",
        "EXECUTION_FAILED",
        "CANCELLED",
        "INTERRUPTED",
        "RESOURCE_LIMIT"
      ]
    },
    "Realm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment": {
          "enum": [
            "production",
            "preview",
            "test"
          ]
        },
        "namespaceId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "environment",
        "namespaceId"
      ]
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deviceId": {
          "$ref": "#/$defs/Id"
        },
        "bootId": {
          "$ref": "#/$defs/Id"
        },
        "sessionId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "deviceId",
        "bootId",
        "sessionId"
      ]
    },
    "SourceTime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "utc": {
          "anyOf": [
            {
              "type": "string",
              "format": "utc-ms"
            },
            {
              "type": "null"
            }
          ]
        },
        "monotonicMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uncertaintyMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "utc",
        "monotonicMs",
        "uncertaintyMs"
      ]
    },
    "IngestTime": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "utc": {
              "type": "string",
              "format": "utc-ms"
            },
            "uncertaintyMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400000
            },
            "deviceId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "utc",
            "uncertaintyMs",
            "deviceId"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "Actor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "human",
            "service",
            "device"
          ]
        },
        "id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "retryable"
      ]
    },
    "Cursor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/Identity"
        },
        "stream": {
          "enum": [
            "event",
            "telemetry"
          ]
        },
        "sequence": {
          "$ref": "#/$defs/Counter"
        }
      },
      "required": [
        "source",
        "stream",
        "sequence"
      ]
    },
    "Target": {
      "$ref": "#/$defs/Identity"
    },
    "Deadline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bootId": {
          "$ref": "#/$defs/Id"
        },
        "sessionId": {
          "$ref": "#/$defs/Id"
        },
        "expiresMonotonicMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "bootId",
        "sessionId",
        "expiresMonotonicMs"
      ]
    },
    "Lease": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/Id"
            },
            "holderId": {
              "$ref": "#/$defs/Id"
            },
            "fence": {
              "$ref": "#/$defs/Counter"
            }
          },
          "required": [
            "id",
            "holderId",
            "fence"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "SiteFrame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "site"
        },
        "revision": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "name",
        "revision"
      ]
    },
    "GimbalFrame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "pod-gimbal"
        },
        "revision": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "name",
        "revision"
      ]
    },
    "NoFrame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "none"
        },
        "revision": {
          "type": "null"
        }
      },
      "required": [
        "name",
        "revision"
      ]
    },
    "VectorMm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "y": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "z": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "CommandBody": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "motion.move"
            },
            "positionMm": {
              "$ref": "#/$defs/VectorMm"
            },
            "frame": {
              "$ref": "#/$defs/SiteFrame"
            },
            "maxSpeedMmPerS": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 1000
            },
            "maxDurationMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30000
            }
          },
          "required": [
            "type",
            "positionMm",
            "frame",
            "maxSpeedMmPerS",
            "maxDurationMs"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "control.stop"
            },
            "reason": {
              "enum": [
                "operator",
                "lease-lost",
                "fault",
                "timeout"
              ]
            }
          },
          "required": [
            "type",
            "reason"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "camera.gimbal"
            },
            "panDeg": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "tiltDeg": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "frame": {
              "$ref": "#/$defs/GimbalFrame"
            },
            "maxDurationMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          "required": [
            "type",
            "panDeg",
            "tiltDeg",
            "frame",
            "maxDurationMs"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "camera.capture"
            },
            "resourceId": {
              "$ref": "#/$defs/Id"
            },
            "maxDurationMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30000
            }
          },
          "required": [
            "type",
            "resourceId",
            "maxDurationMs"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "camera.preview.start"
            },
            "viewSessionId": {
              "$ref": "#/$defs/Id"
            },
            "maxDurationMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30000
            },
            "maxWidthPx": {
              "type": "integer",
              "minimum": 16,
              "maximum": 1920
            },
            "maxFps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "maxBitrateBitsPerS": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 4000000
            }
          },
          "required": [
            "type",
            "viewSessionId",
            "maxDurationMs",
            "maxWidthPx",
            "maxFps",
            "maxBitrateBitsPerS"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "camera.preview.stop"
            },
            "viewSessionId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "type",
            "viewSessionId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "command.cancel"
            },
            "commandId": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "type",
            "commandId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "state.resync"
            },
            "cursor": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Cursor"
                },
                {
                  "type": "null"
                }
              ]
            },
            "committedCursor": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RecoveryCursor"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "cursor",
            "committedCursor"
          ]
        }
      ]
    },
    "CommandContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commandId": {
          "$ref": "#/$defs/Id"
        },
        "correlationId": {
          "$ref": "#/$defs/Id"
        },
        "idempotencyKey": {
          "$ref": "#/$defs/Id"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "deadline": {
          "$ref": "#/$defs/Deadline"
        },
        "lease": {
          "$ref": "#/$defs/Lease"
        },
        "configRevision": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "commandId",
        "correlationId",
        "idempotencyKey",
        "actor",
        "target",
        "deadline",
        "lease",
        "configRevision"
      ]
    },
    "Sample": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metric": {
          "enum": [
            "position.x",
            "position.y",
            "position.z",
            "line.length.a",
            "line.length.b",
            "line.length.c",
            "line.length.d",
            "line.tension.a",
            "line.tension.b",
            "line.tension.c",
            "line.tension.d",
            "power.voltage",
            "gimbal.pan",
            "gimbal.tilt"
          ]
        },
        "quality": {
          "enum": [
            "measured",
            "commanded",
            "estimated",
            "stale",
            "unavailable"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "enum": [
            "mm",
            "N",
            "V",
            "deg"
          ]
        },
        "frame": {
          "oneOf": [
            {
              "$ref": "#/$defs/SiteFrame"
            },
            {
              "$ref": "#/$defs/GimbalFrame"
            },
            {
              "$ref": "#/$defs/NoFrame"
            }
          ]
        },
        "sampleMonotonicMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "ageMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 200000
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "sensor-not-installed",
                "sensor-fault",
                "not-reported",
                "expired"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "originQuality": {
          "anyOf": [
            {
              "enum": [
                "measured",
                "commanded",
                "estimated"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "metric",
        "quality",
        "value",
        "unit",
        "frame",
        "sampleMonotonicMs",
        "ageMs",
        "uncertainty",
        "reason",
        "originQuality"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "quality": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "sampleMonotonicMs": {
                "type": "null"
              },
              "ageMs": {
                "type": "null"
              },
              "uncertainty": {
                "type": "null"
              },
              "originQuality": {
                "type": "null"
              },
              "reason": {
                "enum": [
                  "sensor-not-installed",
                  "sensor-fault",
                  "not-reported"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "number"
              },
              "sampleMonotonicMs": {
                "type": "integer"
              },
              "ageMs": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "quality": {
                "const": "stale"
              }
            }
          },
          "then": {
            "properties": {
              "originQuality": {
                "enum": [
                  "measured",
                  "commanded",
                  "estimated"
                ]
              },
              "reason": {
                "const": "expired"
              }
            }
          },
          "else": {
            "properties": {
              "originQuality": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "quality": {
                "enum": [
                  "measured",
                  "commanded",
                  "estimated"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "position.x"
              }
            }
          },
          "then": {
            "properties": {
              "unit": {
                "const": "mm"
              },
              "frame": {
                "$ref": "#/$defs/SiteFrame"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": -100000,
                    "maximum": 100000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "uncertainty": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 200000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "position.y"
              }
            }
          },
          "then": {
            "properties": {
              "unit": {
                "const": "mm"
              },
              "frame": {
                "$ref": "#/$defs/SiteFrame"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": -100000,
                    "maximum": 100000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "uncertainty": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 200000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "position.z"
              }
            }
          },
          "then": {
            "properties": {
              "unit": {
                "const": "mm"
              },
              "frame": {
                "$ref": "#/$defs/SiteFrame"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": -100000,
                    "maximum": 100000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "uncertainty": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 200000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "line.length.a"
              }
            }
          },
          "then": {
            "properties": {
              "unit": {
                "const": "mm"
              },
              "frame": {
                "$ref": "#/$defs/NoFrame"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "uncertainty": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "line.length.b"
              }
            }
          },
          "then": {
            "properties": {
              "unit": {
                "const": "mm"
              },
              "frame": {
                "$ref": "#/$defs/NoFrame"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "uncertainty": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "line.length.c"
              }
            }
          },
          "then": {
            "properties": {
              "unit": {
                "const": "mm"
              },
              "frame": {
                "$ref": "#/$defs/NoFrame"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "uncertainty": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "line.length.d"
              }
            }
          },
          "then": {
            "properties": {
              "unit": {
                "const": "mm"
              },
              "frame": {
                "$ref": "#/$defs/NoFrame"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "uncertainty": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "line.tension.a"
              }
            }
          },
          "then": {
            "properties": {
              "unit": {
                "const": "N"
              },
              "frame": {
                "$ref": "#/$defs/NoFrame"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "uncertainty": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10000
                  },
