{
  "name": "@arbi/protocol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./schema": "./schema/message.schema.json",
    "./configuration-schema": "./schema/configuration.schema.json",
    "./accounting-schema": "./schema/accounting.schema.json"
  },
  "scripts": {
    "generate": "node scripts/generate-types.mjs && node scripts/generate-accounting-types.mjs",
    "build": "node scripts/generate-types.mjs --check && node scripts/generate-accounting-types.mjs --check && tsc -p tsconfig.build.json",
    "lint": "node scripts/generate-types.mjs --check && node scripts/generate-accounting-types.mjs --check && tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/*.test.js"
  },
  "dependencies": { "ajv": "8.17.1" },
  "devDependencies": { "@types/node": "24.12.4", "typescript": "7.0.2" },
  "engines": { "node": ">=24" }
}
