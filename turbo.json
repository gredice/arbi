{
    "$schema": "https://v2-9-16.turborepo.dev/schema.json",
    "concurrency": "12",
    "cacheDir": ".turbo/cache",
    "globalDependencies": ["tsconfig.base.json", ".nvmrc", ".npmrc"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
        },
        "clean": {
            "cache": false
        },
        "lint": {
            "dependsOn": ["^build"]
        },
        "typecheck": {
            "dependsOn": ["^build", "^typecheck"],
            "outputs": []
        },
        "test": {
            "cache": false,
            "dependsOn": ["^build"],
            "outputs": ["coverage/**", "dist/**"]
        }
    }
}
