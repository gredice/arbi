{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/gredice/arbi/blob/main/hardware/models.schema.json",
    "title": "ARBI OpenSCAD model registry",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "$schema",
        "schemaVersion",
        "units",
        "openScadVersion",
        "models"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "schemaVersion": {
            "const": 1
        },
        "units": {
            "const": "mm"
        },
        "openScadVersion": {
            "const": "2021.01"
        },
        "models": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/model"
            }
        },
        "archivedModels": {
            "type": "array",
            "items": {
                "allOf": [
                    {
                        "$ref": "#/$defs/model"
                    },
                    {
                        "required": [
                            "archiveReason",
                            "supersededBy"
                        ],
                        "properties": {
                            "bomPartIds": {
                                "maxItems": 0,
                                "type": "array"
                            },
                            "archiveReason": {},
                            "supersededBy": {}
                        },
                        "type": "object"
                    }
                ]
            }
        }
    },
    "$defs": {
        "model": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "revision",
                "status",
                "artifactRole",
                "bomPartIds",
                "assembly",
                "entrypoint",
                "output",
                "documentation",
                "description"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "revision": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "status": {
                    "enum": [
                        "concept-unvalidated",
                        "prototype",
                        "validated",
                        "released",
                        "deprecated"
                    ]
                },
                "artifactRole": {
                    "enum": [
                        "fabrication",
                        "reference",
                        "visualization"
                    ]
                },
                "bomPartIds": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    }
                },
                "assembly": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "entrypoint": {
                    "type": "string",
                    "pattern": "^hardware/assemblies/.+\\.scad$"
                },
                "output": {
                    "type": "string",
                    "pattern": "^[a-z0-9.-]+\\.(?:stl|csg)$"
                },
                "documentation": {
                    "type": "string",
                    "pattern": "^hardware/assemblies/.+/README\\.md$"
                },
                "description": {
                    "type": "string",
                    "minLength": 1
                },
                "archiveReason": {
                    "type": "string",
                    "minLength": 1
                },
                "supersededBy": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    }
                },
                "alternativeConfiguration": {
                    "const": "camera-pod-bench"
                },
                "geometry": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "status",
                        "basis",
                        "rework"
                    ],
                    "properties": {
                        "status": {
                            "const": "approximate"
                        },
                        "basis": {
                            "type": "string",
                            "minLength": 1
                        },
                        "rework": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "artifactRole": {
                                "const": "fabrication"
                            }
                        },
                        "not": {
                            "required": [
                                "archiveReason"
                            ],
                            "properties": {
                                "archiveReason": {}
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "bomPartIds": {
                                "type": "array",
                                "minItems": 1
                            },
                            "output": {
                                "type": "string",
                                "pattern": "\\.stl$"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "artifactRole": {
                                "const": "reference"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "bomPartIds": {
                                "type": "array",
                                "maxItems": 0
                            },
                            "output": {
                                "type": "string",
                                "pattern": "\\.csg$"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "artifactRole": {
                                "const": "visualization"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "geometry"
                        ],
                        "properties": {
                            "bomPartIds": {
                                "minItems": 1,
                                "type": "array"
                            },
                            "output": {
                                "pattern": "\\.stl$",
                                "type": "string"
                            },
                            "status": {
                                "const": "concept-unvalidated"
                            },
                            "geometry": {}
                        }
                    },
                    "else": {
                        "not": {
                            "required": [
                                "geometry"
                            ],
                            "properties": {
                                "geometry": {}
                            }
                        }
                    }
                }
            ]
        }
    }
}
