{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/gredice/arbi/blob/main/hardware/models.schema.json",
    "title": "ARBI OpenSCAD model registry",
    "type": "object",
    "additionalProperties": false,
    "required": ["$schema", "schemaVersion", "units", "openScadVersion", "models"],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "schemaVersion": {
            "const": 1
        },
        "units": {
            "const": "mm"
        },
        "openScadVersion": {
            "const": "2021.01"
        },
        "models": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/model"
            }
        }
    },
    "$defs": {
        "model": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "revision",
                "status",
                "artifactRole",
                "bomPartIds",
                "assembly",
                "entrypoint",
                "output",
                "documentation",
                "description"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "revision": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "status": {
                    "enum": [
                        "concept-unvalidated",
                        "prototype",
                        "validated",
                        "released",
                        "deprecated"
                    ]
                },
                "artifactRole": {
                    "enum": ["fabrication", "reference"]
                },
                "bomPartIds": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    }
                },
                "assembly": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "entrypoint": {
                    "type": "string",
                    "pattern": "^hardware/assemblies/.+\\.scad$"
                },
                "output": {
                    "type": "string",
                    "pattern": "^[a-z0-9.-]+\\.(?:stl|csg)$"
                },
                "documentation": {
                    "type": "string",
                    "pattern": "^hardware/assemblies/.+/README\\.md$"
                },
                "description": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "artifactRole": {
                                "const": "fabrication"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "bomPartIds": {
                                "type": "array",
                                "minItems": 1
                            },
                            "output": {
                                "type": "string",
                                "pattern": "\\.stl$"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "artifactRole": {
                                "const": "reference"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "bomPartIds": {
                                "type": "array",
                                "maxItems": 0
                            },
                            "output": {
                                "type": "string",
                                "pattern": "\\.csg$"
                            }
                        }
                    }
                }
            ]
        }
    }
}
